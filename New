

/**
 * mBot maze runner - main sketch.
 *
 * Sketch folder also contains:
 *   LDR.ino   - colour sensing (LDR + RGB LEDs) and optional calibration
 *   motor.ino - movement functions (forward, adjustLeft, turnLeft, turnRight,
 *               uTurn, twoLeftTurn, twoRightTurn, stop, stop_indef)
 *
 * Arduino joins the .ino files with this one first, so the globals below are
 * visible in the other two. Rename this file to match your sketch folder.
 */
#include <MeMCore.h>

// ---------- Build options ----------
// change to 0 if no calibrate
#define CALIBRATE_ON_BOOT 0 // 1 = walk through colour calibration at startup, 0 = skip (race day)
#define DEBUG_SERIAL      1  // 1 = print debug info to the Serial Monitor

#if DEBUG_SERIAL
  #define DEBUG_PRINTLN(x) Serial.println(x)
#else
  #define DEBUG_PRINTLN(x)
#endif

// ---------- Delays (used in LDR.ino) ----------
#define RGBWait 200  // ms, LDR settling time after switching LED
#define LDRWait 10   // ms, gap between LDR samples

// ---------- Motor settings (used in motor.ino) ----------
#define SPEED              255  // 0 - 255
#define FORWARD_DELAY      100  // ms
#define TURN_DELAY_right   320  // ms (before calibration: 335)
#define TURN_DELAY_left    310  // ms (before calibration: 300, 320)
#define ONEBOX_DELAY_blue  640  // ms (before calibration: 610)
#define ONEBOX_DELAY_pink  660  // ms
#define UTURN_DELAY        290  // ms

// The mBot doesn't drive straight at equal power, so each side gets its own trim
uint8_t speed_right = 215;
uint8_t speed_left  = 235;
uint8_t turnSpeed   = 100;

// ---------- Pins ----------
#define DECODER_PIN_A A2  // LED decoder control pin A
#define DECODER_PIN_B A0  // LED decoder control pin B
#define IR            A1  // IR receiver (right wall)
#define LDR           A3  // light sensor

// ---------- Right wall (IR) ----------
const int IR_TOO_CLOSE = 225;  // reading <= this means too close to the right wall

// ---------- Left wall (ultrasonic P-controller) ----------
const float TARGET_CM      = 8.0;   // distance to hold from the left wall
const float WALL_LOST_CM   = 20.0;  // beyond this = no wall, drive straight
const float KP             = 12.0;  // steering strength (speed per cm of error)
const int   MAX_CORRECTION = 80;    // cap on steering correction
const float SMOOTHING      = 0.3;   // 0..1, lower = smoother but slower to react

float filteredDist   = TARGET_CM;
bool  hadWall        = false;
int   leftCorrection = 0;  // + = too close to left wall (steer right), - = too far (steer left)

// ---------- Hardware objects ----------
MeDCMotor leftMotor(M1);
MeDCMotor rightMotor(M2);
MeRGBLed led(0, 30);
MeLineFollower lineFinder(PORT_1);
MeUltrasonicSensor ultraSensor(PORT_2);
MeBuzzer buzzer;

// ---------- Colour data ----------
enum Colour { COL_RED, COL_GREEN, COL_ORANGE, COL_PINK, COL_BLUE, COL_WHITE, NUM_COLOURS };

const char* colourNames[NUM_COLOURS] = { "Red", "Green", "Orange", "Pink", "Blue", "White" };

// Reference R, G, B LDR readings per colour (re-measure on test day).
// Run the calibration (CALIBRATE_ON_BOOT) and paste its output here.
const int calibratedColors[NUM_COLOURS][3] = {
  { 861, 322, 851 },  // Red
  { 879, 448, 884 },  // Green
  { 870, 397, 870 },  // Orange
  { 901, 507, 906 },  // Pink
  { 886, 498, 892 },  // Blue
  { 921, 555, 924 },  // White
};

// Colours shown on the mBot's onboard LEDs after detection (debug)
const int displayLED[NUM_COLOURS][3] = {
  { 255,   0,   0 },  // Red
  {   0, 255,   0 },  // Green
  { 255,  50,   0 },  // Orange
  { 128,   0, 128 },  // Pink
  {   0,   0, 255 },  // Blue
  { 255, 255, 255 },  // White
};

// ---------- Setup ----------
void setup() {
  Serial.begin(9600);

  leftMotor.stop();
  rightMotor.stop();

  pinMode(IR, INPUT);
  pinMode(LDR, INPUT);
  pinMode(DECODER_PIN_A, OUTPUT);
  pinMode(DECODER_PIN_B, OUTPUT);

  led.setpin(13);
  offLED();

#if CALIBRATE_ON_BOOT
  calibrateColours();  // in LDR.ino
#endif

  delay(5000);  // time to place the mBot at the start
}

// ---------- Waypoint challenge ----------
// Runs the move thatmatches the colour under the mBot.
void action() {
  switch (detectColor()) {  // in LDR.ino
    case COL_RED:    turnLeft();     break;
    case COL_GREEN:  turnRight();    break;
    case COL_ORANGE: uTurn();        break;
    case COL_PINK:   twoLeftTurn();  break;
    case COL_BLUE:   twoRightTurn(); break;
    default:         stop_indef();   break;  // white (or no match) = finish
  }
}

// ---------- Wall following ----------
// One ultrasonic ping. Returns true if a left wall is being tracked and
// updates leftCorrection.
bool updateLeftWall() {
  float raw = ultraSensor.distanceCm();
  if (raw <= 0) return hadWall;  // bad reading: keep last correction

  if (raw >= WALL_LOST_CM) {     // no wall (also catches 400 = "no echo")
    hadWall = false;
    leftCorrection = 0;
    return false;
  }

  if (!hadWall) {                // wall reappeared: reseed the filter
    filteredDist = raw;
    hadWall = true;
  }
  filteredDist = SMOOTHING * raw + (1 - SMOOTHING) * filteredDist;

  float error = TARGET_CM - filteredDist;  // + = too close to left, - = too far
  leftCorrection = constrain((int)(KP * error), -MAX_CORRECTION, MAX_CORRECTION);
  return true;
}

// Drives both motors. If one side would exceed 255, the overflow is taken off the
// other side so the steering difference is preserved.
// Check the sign convention against forward() in motor.ino.
void drive(int l, int r) {
  if (l > 255) { r -= (l - 255); l = 255; }
  if (r > 255) { l -= (r - 255); r = 255; }
  leftMotor.run(-constrain(l, 0, 255));
  rightMotor.run(constrain(r, 0, 255));
}

// ---------- Main loop ----------
void loop() {
  bool leftWall = updateLeftWall();

  // IR is only read when there's no left wall, or when we're not already
  // steering left (away from the right wall). Otherwise it stays "far".
  int irValue = 1023;
  if (!leftWall || leftCorrection >= 0) {
    irValue = analogRead(IR);
    DEBUG_PRINTLN(irValue);
  }

  if (irValue <= IR_TOO_CLOSE) {
    adjustLeft();  // too close to the right wall
  } else if (leftWall) {
    // too close to left -> left motor faster, right slower -> steers right
    drive(speed_left + leftCorrection, speed_right - leftCorrection);
  } else {
    forward();
  }

  // Black line under the mBot: stop, read the colour, act on it
  if (lineFinder.readSensors() == S1_IN_S2_IN) {
    stop(10);
    action();
  }

  /* -------------- debug-------------------------
